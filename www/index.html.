<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8"><title>Hexa</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1e6bff"><meta name="description" content="Hexa : le réseau social qui connecte le monde entier.">
<style>
:root{--bg:#f3f6ff;--cd:#fff;--tx:#14182b;--mu:#64698a;--bl:#1e6bff;--gr:#12b76a;--rd:#e5383b;--dm:#b9f2ff;--bd:#dfe5fa}
@media(prefers-color-scheme:dark){:root{--bg:#0e1120;--cd:#181c32;--tx:#eef1ff;--mu:#9aa0c4;--bd:#2a3052}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:15px system-ui,sans-serif;max-width:680px;margin:auto;padding-bottom:76px}
input,textarea,select{width:100%;border:1px solid var(--bd);background:var(--bg);color:var(--tx);border-radius:10px;padding:10px;font:inherit}
button{background:var(--bl);color:#fff;border:0;border-radius:10px;padding:9px 14px;font:inherit;cursor:pointer}button.g{background:none;color:var(--mu);padding:6px}
.c{background:var(--cd);border:1px solid var(--bd);border-radius:14px;padding:12px;margin:10px 12px}
.t{color:var(--mu);font-size:12px}.r{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}
header{position:sticky;top:0;z-index:5;background:var(--bg);display:flex;align-items:center;gap:8px;padding:10px 14px}header h1{margin:0;font-size:24px;background:linear-gradient(90deg,var(--bl),var(--gr),var(--rd));-webkit-background-clip:text;background-clip:text;color:transparent}
img.p{width:100%;border-radius:10px;margin-top:8px}.av{width:32px;height:32px;border-radius:50%;object-fit:cover;vertical-align:middle;margin-right:8px;border:2px solid var(--gr)}
nav{position:fixed;bottom:0;left:0;right:0;max-width:680px;margin:auto;display:flex;background:var(--cd);border-top:1px solid var(--bd);padding-bottom:env(safe-area-inset-bottom)}nav button{flex:1;background:none;color:var(--mu);border-radius:0;padding:14px 4px}nav .on{color:var(--bl);font-weight:700}
.chips{display:flex;gap:6px;overflow-x:auto;padding:0 12px}.chips button{background:var(--cd);color:var(--tx);border:1px solid var(--bd);white-space:nowrap;border-radius:20px}.chips .on{background:var(--bl);color:#fff}
#auth{min-height:100vh;padding:24px 16px;background:radial-gradient(circle at 10% 5%,#1e6bff55,transparent 45%),radial-gradient(circle at 95% 25%,#e5383b44,transparent 40%),radial-gradient(circle at 50% 100%,#12b76a55,transparent 50%)}
#auth .box{max-width:480px;margin:auto;background:var(--cd);border-radius:22px;padding:20px;box-shadow:0 10px 40px #1e6bff33}#auth h2{text-align:center;margin:4px 0;background:linear-gradient(90deg,var(--bl),var(--gr),var(--rd));-webkit-background-clip:text;background-clip:text;color:transparent;font-size:28px}
#auth label{display:block;font-size:12px;color:var(--mu);margin:10px 0 3px}.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.big{width:100%;margin-top:14px;padding:13px;background:linear-gradient(90deg,var(--bl),var(--gr) 55%,var(--rd))}
.msg{padding:7px 11px;border-radius:12px;background:var(--bg);margin:6px 0;max-width:85%}.msg.me{background:var(--bl);color:#fff;margin-left:auto}
</style></head><body>
<div id="auth" hidden><div class="box"><div id="lgb" style="text-align:center"></div><h2>Hexa</h2><p class="t" style="text-align:center">Connectez-vous au monde entier</p>
<div id="su" hidden><label style="text-align:center"><img id="pav" class="av" style="width:90px;height:90px;display:block;margin:6px auto" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'%3E%3Crect width='10' height='10' fill='%23cfd8ff'/%3E%3Ccircle cx='5' cy='4' r='2' fill='%231e6bff'/%3E%3Cellipse cx='5' cy='9' rx='3.5' ry='2.5' fill='%231e6bff'/%3E%3C/svg%3E"><span style="color:#1e6bff">📷 Photo de profil</span><input id="rph" type="file" accept="image/*" hidden></label>
<div class="g2"><div><label>Prénom *</label><input id="f1"></div><div><label>Nom *</label><input id="f2"></div><div><label>Post-nom</label><input id="f3"></div><div><label>Sexe</label><select id="f4"><option>Masculin</option><option>Féminin</option><option>Autre</option></select></div><div><label>Naissance *</label><input id="f5" type="date"></div><div><label>Nationalité</label><input id="f6"></div><div><label>Pays *</label><input id="f7"></div><div><label>Ville *</label><input id="f8"></div></div>
<label>Adresse</label><input id="f9"><label>Téléphone *</label><input id="f10" type="tel"></div>
<label>E-mail *</label><input id="em" type="email"><label>Mot de passe * (8 caractères min.)</label><input id="pw" type="password">
<button class="big" id="ok">Se connecter</button><p class="t" id="er" style="color:#e5383b;text-align:center"></p><p style="text-align:center"><a href="#" id="tg" style="color:#1e6bff">Pas de compte ? Créer mon compte</a></p></div></div>
<div id="app" hidden><header><span id="lgs"></span><h1>Hexa</h1><span class="t" id="who" style="margin-left:auto"></span><button class="g" id="out">Quitter</button></header>
<div id="v-news"><div class="chips" id="chips"></div><div id="news"></div></div>
<div id="v-feed" hidden><div class="c"><textarea id="tx" rows="2" placeholder="Quoi de neuf ?"></textarea><div class="r"><select id="act" style="width:auto"><option value="">Activité…</option><option>😊 Heureux</option><option>🎵 J'écoute</option><option>🍽️ Je mange</option><option>✈️ Je voyage</option><option>📚 J'étudie</option><option>💼 Je travaille</option></select><label style="cursor:pointer">📷<input id="ph" type="file" accept="image/*" hidden></label><button class="g" id="mic">🎤 Vocal</button><button id="pub" style="margin-left:auto">Publier</button></div><div id="pv" class="t"></div></div><div id="posts"></div></div>
<div id="v-dm" hidden><div class="c"><select id="who2"></select><div id="dm" style="max-height:50vh;overflow:auto;margin-top:8px"></div><div class="r"><input id="dmt" placeholder="Message privé…" style="flex:1;width:auto"><button class="g" id="dmic">🎤</button><button id="dms">Envoyer</button></div></div></div>
<div id="v-me" hidden><div class="c"><b id="mn"></b><p class="t" id="mp"></p><button class="g" id="nt">🔔 Activer les notifications</button></div><div class="c"><b>Mes amis</b><input id="fs" placeholder="Rechercher par nom, ville ou pays…" style="margin-top:8px"><div id="fr"></div></div></div>
<nav><button class="on" data-v="news">📰 Actualités</button><button data-v="feed">🏠 Fil</button><button data-v="dm">💬 Messages<span id="bd" style="background:var(--rd);color:#fff;border-radius:10px;padding:0 6px;font-size:11px;margin-left:4px" hidden></span></button><button data-v="me">👤 Moi<span id="bf" style="background:var(--rd);color:#fff;border-radius:10px;padding:0 6px;font-size:11px;margin-left:4px" hidden></span></button></nav></div>
